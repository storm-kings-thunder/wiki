{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wiki",
  "compatibility_date": "2026-04-15",
  "observability": {
    "enabled": false
  },
  "assets": {
    // `public/` is generated by `npx quartz build` and may not exist in a fresh checkout.
    // The deploy/preview npm scripts handle this automatically.
    "directory": "public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
